<?xml version="1.0" encoding="utf-8"?>
<!--
  The phone-specific pieces both the app and the agent need: the crypto and
  socket shims, the stored session, settings, and the update position.

  A library rather than linked sources, for the same reason Core is one: the
  app references the agent so its DLL ships in the package, and compiling
  these files into both projects gave every type two identities. A
  PhoneSession written by the agent would not have been assignable to one in
  the app.

  Separate from Core because Core must stay platform-free - the desktop
  harness compiles those same sources, and they cannot mention WinRT.
-->
<Project ToolsVersion="14.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProductVersion>10.0.20506</ProductVersion>
