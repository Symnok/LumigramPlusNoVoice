<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest" xmlns:m2="http://schemas.microsoft.com/appx/2013/manifest" xmlns:m3="http://schemas.microsoft.com/appx/2014/manifest" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest">
  <Identity Name="8f2b1c40-lumigramplus-0002" Publisher="CN=Lumigram" Version="1.41.0.0" />
  <mp:PhoneIdentity PhoneProductId="7B1C9D42-6E30-4A85-B2F9-1D40C8E5A736" PhonePublisherId="B1D9E4F0-2C7A-4E58-9F31-6A8D0C5B2E14" />
  <Properties>
    <DisplayName>Lumigram+ (WinRT)</DisplayName>
    <PublisherDisplayName>Lumigram</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Prerequisites>
    <OSMinVersion>6.3.1</OSMinVersion>
    <OSMaxVersionTested>6.3.1</OSMaxVersionTested>
  </Prerequisites>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="LumigramPlus.App.App">
      <m3:VisualElements DisplayName="Lumigram+" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" Description="Telegram client for Windows Phone 8.1" ForegroundText="light" BackgroundColor="#464646" ToastCapable="true">
        <m3:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" Wide310x150Logo="Assets\Wide310x150Logo.png">
          <!-- Without this the tile is an unlabelled square. The small 71x71 tile
               has no room for a name and is not listed here. -->
          <m3:ShowNameOnTiles>
            <m3:ShowOn Tile="square150x150Logo" />
            <m3:ShowOn Tile="wide310x150Logo" />
          </m3:ShowNameOnTiles>
        </m3:DefaultTile>
        <m3:SplashScreen Image="Assets\SplashScreen.png" />
      </m3:VisualElements>
      <!--
        The whole point of the spike. controlChannel lets a background task be
        woken when data arrives on a socket registered with
        ControlChannelTrigger - the nearest thing WinRT has to the continuous
        execution the Silverlight build gets from its location subscription.
      -->
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClientServer" />
    <!-- Saving a picture into the gallery. Without it KnownFolders.SavedPictures
         is simply not there, and the copy fails at runtime rather than at build. -->
    <Capability Name="picturesLibrary" />
  </Capabilities>
</Package>