<Page
    x:Class="LumigramPlus.App.ChatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="16,24,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="LUMIGRAM+" FontSize="14" Opacity="0.6"/>
            <TextBlock Text="chats" FontSize="30"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.7" FontSize="14"/>
        </StackPanel>

        <ListView x:Name="DialogList" Grid.Row="2"
                  SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Dialog_Click">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- The picture sits over the initials rather than
                             replacing them: many chats have no photo at all, and the
                             letters are the answer for those rather than a
                             placeholder waiting to be filled. -->
                        <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0"
                              VerticalAlignment="Top">
                            <Border Background="{ThemeResource PhoneAccentBrush}">
                                <TextBlock Text="{Binding Initials}" Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                        </Grid>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           FontSize="20"/>
                                <TextBlock Text="muted" Visibility="{Binding MutedVisibility}"
                                           Opacity="0.45" FontSize="12" Margin="8,4,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Preview}" Opacity="0.6" FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="2" Visibility="{Binding UnreadVisibility}"
                                Background="{ThemeResource PhoneAccentBrush}"
                                CornerRadius="11" Padding="8,2,8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UnreadCount}" Foreground="White"
                                       FontSize="14"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Icon="Refresh" Label="refresh" Click="Refresh_Click"/>
            <AppBarButton Icon="Setting" Label="settings" Click="Settings_Click"/>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
