<Page
    x:Class="LumigramPlus.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="16,24,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="LUMIGRAM+" FontSize="14" Opacity="0.6"/>
            <TextBlock Text="settings" FontSize="30"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <ToggleSwitch x:Name="AutoLoadSwitch" Header="Download photos automatically"
                          OnContent="on" OffContent="off"
                          Toggled="AutoLoad_Toggled"/>
            <TextBlock Text="Off means photos are fetched only when tapped, which is worth having on a metered connection."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Page>
