    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{C7A2F1E4-9B36-4D58-8E01-5A7C3D2B6F19}</ProjectGuid>
    <OutputType>AppContainerExe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>LumigramPlus.App</RootNamespace>
    <AssemblyName>LumigramPlus.App</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformIdentifier>WindowsPhoneApp</TargetPlatformIdentifier>
    <TargetPlatformVersion>8.1</TargetPlatformVersion>
    <MinimumVisualStudioVersion>12</MinimumVisualStudioVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuids>{76F1466A-8B6D-4E39-A767-685A06062A39};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <!--
      An appx has to be signed or the phone refuses to register it, and the
      certificate subject has to match the Publisher in the manifest exactly -
      "CN=Lumigram" in both places, or the package is rejected as not matching its
      own identity.

      Signed from the certificate store by thumbprint rather than from a .pfx in
      the tree: a signing key is not something to commit, and this way there is
      nothing to gitignore and nothing to leak. Recreate with
      New-SelfSignedCertificate -Subject "CN=Lumigram" if the machine changes.
    -->
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>41D4101F11E0F9A761DB8472879467D32DDA9480</PackageCertificateThumbprint>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <AppxBundlePlatforms>arm</AppxBundlePlatforms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
