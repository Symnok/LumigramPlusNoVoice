<phone:PhoneApplicationPage
    x:Class="Lumigram.Phone.ConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,17,12,6">
            <TextBlock x:Name="PeerTitle" Text="chat" TextWrapping="NoWrap"
                       Style="{StaticResource PhoneTextTitle2Style}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="12,0,12,4">
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.7"
                       Style="{StaticResource PhoneTextSmallStyle}"/>
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="2" Margin="0,0,0,0">
            <ItemsControl x:Name="MessageList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="{Binding Margin}" CornerRadius="6" Padding="10,6,10,6"
                                Background="{Binding Background}"
                                HorizontalAlignment="{Binding Align}"
                                Hold="Message_Hold">
                            <StackPanel>
                                <!-- Only groups and channels: in a one-to-one chat
                                     the sender is never in doubt. -->
                                <TextBlock Text="{Binding SenderName}"
                                           Visibility="{Binding SenderVisibility}"
                                           Foreground="{StaticResource PhoneAccentBrush}"
                                           TextWrapping="NoWrap" Margin="0,0,0,2"
                                           Style="{StaticResource PhoneTextSmallStyle}"/>
                                <Image Source="{Binding Image}"
                                       Visibility="{Binding ImageVisibility}"
                                       MaxWidth="260" MaxHeight="260"
                                       Stretch="Uniform" Margin="0,0,0,4"
                                       Tap="Media_Tap"/>
                                <TextBlock Text="{Binding MediaNote}"
                                           Visibility="{Binding MediaNoteVisibility}"
                                           TextWrapping="Wrap" Opacity="0.8"
                                           Style="{StaticResource PhoneTextSmallStyle}"
                                           Tap="Media_Tap"/>
                                <!--
                                  No Text binding: the runs are built in code so a
                                  link can be coloured differently from the words
                                  around it. Setting both would have the binding
                                  overwrite the runs.
                                -->
                                <TextBlock TextWrapping="Wrap"
                                           Visibility="{Binding TextVisibility}"
                                           Style="{StaticResource PhoneTextNormalStyle}"
                                           Margin="0"
                                           Loaded="MessageText_Loaded"
                                           Tap="MessageText_Tap"/>
                                <TextBlock Text="{Binding Time}" Opacity="0.5" Margin="0,2,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource PhoneTextSmallStyle}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ComposeBox" Grid.Column="0" TextWrapping="Wrap"
                     AcceptsReturn="False" KeyDown="ComposeBox_KeyDown"/>

            <!--
              Shown in place of the message box while recording. It sits in the same
              cell so the compose bar does not change size, and it carries a moving
              level so it is obvious the microphone is live rather than merely armed.
            -->
            <Border x:Name="RecordingPanel" Grid.Column="0" Visibility="Collapsed"
                    Background="{StaticResource PhoneChromeBrush}" Padding="10,8,10,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="RecordingDot" Width="16" Height="16" Fill="Red"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="RecordingTime" Text="0:00" Margin="10,0,10,0"
                               VerticalAlignment="Center" Foreground="Red"
                               Style="{StaticResource PhoneTextNormalStyle}"/>
                    <Border Background="#40FFFFFF" Width="110" Height="10"
                            VerticalAlignment="Center">
                        <Rectangle x:Name="RecordingLevel" Fill="Red" Width="0"
                                   HorizontalAlignment="Left"/>
                    </Border>
                </StackPanel>
            </Border>

            <Button x:Name="AttachButton" Grid.Column="1" Content="+" Click="Attach_Click"
                    MinWidth="60"/>
            <Button x:Name="SendButton" Grid.Column="2" Content="send" Click="Send_Click"/>
        </Grid>
        <!--
          What the + button offers. A menu rather than two buttons on the compose
          bar: the bar is narrow, and every button on it is width the message box
          does not get.
        -->
        <Border x:Name="AttachActions" Grid.RowSpan="4" Visibility="Collapsed"
                Background="#C0000000" Tap="AttachActions_Tap">
            <Border Background="{StaticResource PhoneChromeBrush}" Margin="24"
                    VerticalAlignment="Center" Padding="16">
                <StackPanel>
                    <TextBlock Text="attach" Margin="0,0,0,12"
                               Style="{StaticResource PhoneTextLargeStyle}"/>
                    <Button Content="picture" Click="AttachPicture_Click"/>
                    <Button Content="voice message" Click="AttachVoice_Click"/>
                    <Button Content="my location" Click="AttachLocation_Click"/>
                    <Button Content="cancel" Click="CancelAttachMenu_Click"/>
                </StackPanel>
            </Border>
        </Border>
        <!-- long-tap actions for a message -->
        <Border x:Name="MessageActions" Grid.RowSpan="4" Visibility="Collapsed"
                Background="#C0000000" Tap="MessageActions_Tap">
            <Border Background="{StaticResource PhoneChromeBrush}" Margin="24"
                    VerticalAlignment="Center" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="MessageActionTitle" TextWrapping="Wrap" Margin="0,0,0,12"
                               Style="{StaticResource PhoneTextLargeStyle}"/>
                    <Button x:Name="SaveMediaButton" Content="save to gallery" Click="SaveImage_Click"/>
                    <Button x:Name="OpenFullScreenButton" Content="open full screen" Click="OpenImage_Click"/>
                    <!-- One button per link in the message, added when the menu opens. -->
                    <StackPanel x:Name="LinkButtons"/>
                    <Button x:Name="DeleteForMeButton" Content="delete for me" Click="DeleteForMe_Click"/>
                    <Button x:Name="DeleteForAllButton" Content="delete for everyone" Click="DeleteForAll_Click"/>
                    <Button Content="cancel" Click="CancelMenu_Click"/>
                </StackPanel>
            </Border>
        </Border>
        <!--
          In-app notification banner.

          Windows Phone does not show a toast to the app that raised it, so the
          foreground case needs its own banner. Placed last in the Grid so it
          paints over everything, and spanning all rows for the same reason.
        -->
        <Border x:Name="BannerPanel" Grid.RowSpan="9" Visibility="Collapsed"
                VerticalAlignment="Top" Margin="0" Padding="12,10,12,10"
                Background="{StaticResource PhoneAccentBrush}"
                Tap="Banner_Tap">
            <StackPanel>
                <TextBlock x:Name="BannerTitle" Foreground="White" TextWrapping="NoWrap"
                           Style="{StaticResource PhoneTextLargeStyle}" Margin="0"/>
                <TextBlock x:Name="BannerBody" Foreground="White" TextWrapping="Wrap"
                           Style="{StaticResource PhoneTextSmallStyle}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>

</phone:PhoneApplicationPage>
