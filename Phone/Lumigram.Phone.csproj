  <!--
    Bumps the app version before every real build, so each deployment installs as
    an upgrade rather than a fresh install. Same ProductID + higher version means
    isolated storage survives - the signed-in session and media cache are kept.

    The resulting version is also put in the .xap filename. XapFilename cannot
    simply reference the version as a property: properties are evaluated when the
    project loads, which is before this target has run, so the name would always
    be one build stale. Setting it here, inside the target, is what makes it match
    the package it names.

    Guarded against design-time builds only: VS evaluates the project constantly
    while editing, and bumping there would churn the file for no reason.

    Note there is deliberately no BuildingProject check - this project type leaves
    that property false even during a real build, so including it silently
    disabled the whole target.

    Pass -p:BumpPackageVersion=false to keep the version but still name the file.
  -->
  <Target Name="BumpPackageVersion" BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">

    <!-- Bump, or just read the current version when bumping is turned off. -->
    <Exec Command="powershell -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\BumpVersion.ps1&quot; -Quiet"
          ConsoleToMSBuild="true" ContinueOnError="true"
          Condition="'$(BumpPackageVersion)' != 'false'">
      <Output TaskParameter="ConsoleOutput" PropertyName="AppVersionFromScript" />
    </Exec>

    <Exec Command="powershell -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\BumpVersion.ps1&quot; -Show -Quiet"
          ConsoleToMSBuild="true" ContinueOnError="true"
          Condition="'$(BumpPackageVersion)' == 'false'">
      <Output TaskParameter="ConsoleOutput" PropertyName="AppVersionFromScript" />
    </Exec>

    <PropertyGroup>
      <XapFilename Condition="'$(AppVersionFromScript)' != ''">Lumigram.Phone_$(AppVersionFromScript)_$(Configuration)_$(Platform).xap</XapFilename>
    </PropertyGroup>

    <Message Importance="high" Text="Lumigram version $(AppVersionFromScript) -> $(XapFilename)"
             Condition="'$(AppVersionFromScript)' != ''" />
  </Target>

