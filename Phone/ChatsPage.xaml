<phone:PhoneApplicationPage
    x:Class="Lumigram.Phone.ChatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,17,0,12">
            <TextBlock Text="Lumigram" Style="{StaticResource PhoneTextNormalStyle}"/>
            <TextBlock Text="chats" Margin="9,-7,0,0"
                       Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <!--
          Folder tabs. A scrolling row of buttons rather than a Pivot: a Pivot owns
          the whole page and swipes between fixed sections, where these are read from
          the account and change. One list underneath serves them all.
        -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="0,0,0,4" Padding="6,0,6,0">
            <StackPanel x:Name="FolderTabs" Orientation="Horizontal"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="12,0,12,6">
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.7"
                       Style="{StaticResource PhoneTextSmallStyle}"/>
        </StackPanel>

        <ListBox x:Name="DialogList" Grid.Row="3" Margin="0,0,0,0"
                 SelectionChanged="DialogList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,10,12,10" Hold="Dialog_Hold">
                        <Grid.Background>
                            <SolidColorBrush Color="Transparent"/>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!--
                          The picture, with initials behind it. The initials are not a
                          placeholder to be replaced - plenty of people have no photo
                          set at all, and a blank disc says nothing where two letters
                          identify the chat immediately.
                        -->
                        <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,12,0"
                              VerticalAlignment="Center">
                            <Ellipse Fill="{StaticResource PhoneAccentBrush}"/>
                            <TextBlock Text="{Binding Initials}" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource PhoneTextNormalStyle}"/>
                            <Image Source="{Binding Avatar}" Width="48" Height="48"
                                   Stretch="UniformToFill"/>
                        </Grid>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" TextWrapping="NoWrap"
                                           Style="{StaticResource PhoneTextLargeStyle}"
                                           Margin="0"/>
                                <!--
                                  A crossed-out speaker, so a muted chat is
                                  recognisable at a glance without spending a word
                                  of the title's width on it. Drawn rather than a
                                  glyph: this platform has no icon font that can be
                                  relied on, and a missing character would show as
                                  an empty box.
                                -->
                                <Canvas Width="17" Height="12" Opacity="0.55"
                                        Margin="8,2,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding MutedVisibility}">
                                    <Path Fill="{StaticResource PhoneForegroundBrush}"
                                          Data="M0,4 L2.5,4 L6,0.5 L6,11.5 L2.5,8 L0,8 Z"/>
                                    <Path Stroke="{StaticResource PhoneForegroundBrush}"
                                          StrokeThickness="1.4"
                                          Data="M9.5,3.5 L15.5,8.5 M15.5,3.5 L9.5,8.5"/>
                                </Canvas>
                            </StackPanel>
                            <TextBlock Text="{Binding Preview}" TextWrapping="NoWrap"
                                       Opacity="0.6" Margin="0,-4,0,0"
                                       Style="{StaticResource PhoneTextSmallStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="2" Visibility="{Binding UnreadVisibility}"
                                Background="{StaticResource PhoneAccentBrush}"
                                CornerRadius="12" Padding="8,2,8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UnreadCount}" Foreground="White"
                                       Style="{StaticResource PhoneTextSmallStyle}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--
          Shown only while the server says there are more. Separate from refresh on
          purpose: refresh has to keep meaning "read the list again from the top",
          because that is what puts the unread counts right when returning from a
          chat. Overloading it to also append would make those two jobs fight.
        -->
        <Button x:Name="LoadMoreButton" Grid.Row="4" Content="load more chats"
                Click="LoadMore_Click" Visibility="Collapsed" Margin="12,0,12,12"/>

        <!-- long-tap actions. A plain overlay rather than a ContextMenu: the
             Silverlight toolkit is not referenced, and this needs no dependency. -->
        <Border x:Name="ActionOverlay" Grid.RowSpan="5" Visibility="Collapsed"
                Background="#C0000000" Tap="ActionOverlay_Tap">
            <Border Background="{StaticResource PhoneChromeBrush}" Margin="24"
                    VerticalAlignment="Center" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="ActionTitle" TextWrapping="Wrap" Margin="0,0,0,12"
                               Style="{StaticResource PhoneTextLargeStyle}"/>
                    <Button x:Name="MuteButton" Content="mute" Click="Mute_Click"/>
                    <Button x:Name="ArchiveButton" Content="archive" Click="Archive_Click"/>
                    <!--
                      One button per folder, ticked when the chat is in it. A list of
                      toggles rather than separate add, remove and move commands: a
                      move is untick one, tick another, and the state is visible
                      instead of having to be remembered.
                    -->
                    <StackPanel x:Name="FolderToggles"/>
                    <Button Content="clear history" Click="ClearHistory_Click"/>
                    <Button Content="delete chat" Click="DeleteChat_Click"/>
                    <Button Content="cancel" Click="CancelMenu_Click"/>
                </StackPanel>
            </Border>
        </Border>
        <!--
          In-app notification banner.

          Windows Phone does not show a toast to the app that raised it, so the
          foreground case needs its own banner. Placed last in the Grid so it
          paints over everything, and spanning all rows for the same reason.
        -->
        <Border x:Name="BannerPanel" Grid.RowSpan="9" Visibility="Collapsed"
                VerticalAlignment="Top" Margin="0" Padding="12,10,12,10"
                Background="{StaticResource PhoneAccentBrush}"
                Tap="Banner_Tap">
            <StackPanel>
                <TextBlock x:Name="BannerTitle" Foreground="White" TextWrapping="NoWrap"
                           Style="{StaticResource PhoneTextLargeStyle}" Margin="0"/>
                <TextBlock x:Name="BannerBody" Foreground="White" TextWrapping="Wrap"
                           Style="{StaticResource PhoneTextSmallStyle}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True">
            <shell:ApplicationBarIconButton x:Name="RefreshButton"
                IconUri="/Assets/appbar.refresh.png" Text="refresh" Click="Refresh_Click"/>
            <shell:ApplicationBarIconButton x:Name="NewChatButton"
                IconUri="/Assets/appbar.add.png" Text="new chat" Click="NewChat_Click"/>
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="new chat" Click="NewChat_Click"/>
                <shell:ApplicationBarMenuItem Text="settings" Click="Settings_Click"/>
                <shell:ApplicationBarMenuItem Text="exit" Click="Exit_Click"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

</phone:PhoneApplicationPage>
