<phone:PhoneApplicationPage
    x:Class="Lumigram.Phone.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,17,0,28">
            <TextBlock Text="Lumigram" Style="{StaticResource PhoneTextNormalStyle}"/>
            <TextBlock x:Name="StageTitle" Text="sign in" Margin="9,-7,0,0"
                       Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="12,0,12,0">

            <!-- phone number -->
            <StackPanel x:Name="PhonePanel">
                <TextBlock Text="Country code and number, digits only."
                           TextWrapping="Wrap" Opacity="0.7"
                           Style="{StaticResource PhoneTextSmallStyle}"/>
                <TextBox x:Name="PhoneBox" InputScope="TelephoneNumber" Margin="0,12,0,0"/>
                <Button x:Name="SendCodeButton" Content="send code" Click="SendCode_Click"/>
                <Button x:Name="QrButton" Content="sign in by QR code instead" Click="Qr_Click"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.6" Margin="12,0,0,0"
                           Style="{StaticResource PhoneTextSmallStyle}"
                           Text="Use QR if the code never arrives. Needs another device already signed in to Telegram."/>
            </StackPanel>

            <!-- login code -->
            <StackPanel x:Name="CodePanel" Visibility="Collapsed">
                <TextBlock x:Name="CodeHint" TextWrapping="Wrap" Opacity="0.7"
                           Style="{StaticResource PhoneTextSmallStyle}"/>
                <TextBox x:Name="CodeBox" InputScope="Number" Margin="0,12,0,0"/>
                <Button x:Name="SignInButton" Content="sign in" Click="SignIn_Click"/>
                <Button x:Name="BackToPhoneButton" Content="use a different number"
                        Click="BackToPhone_Click"/>
            </StackPanel>

            <!-- two-step verification -->
            <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
                <TextBlock Text="This account has two-step verification enabled."
                           TextWrapping="Wrap" Opacity="0.7"
                           Style="{StaticResource PhoneTextSmallStyle}"/>
                <PasswordBox x:Name="PasswordBoxControl" Margin="0,12,0,0"/>
                <Button x:Name="CheckPasswordButton" Content="continue" Click="CheckPassword_Click"/>
                <TextBlock Text="Checking the password takes about 15 seconds on this device."
                           TextWrapping="Wrap" Opacity="0.5" Margin="12,6,0,0"
                           Style="{StaticResource PhoneTextSmallStyle}"/>
            </StackPanel>

            <!-- progress / errors, shown over whichever panel is active -->
            <StackPanel x:Name="BusyPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"/>
                <TextBlock x:Name="BusyText" TextWrapping="Wrap" HorizontalAlignment="Center"
                           Margin="0,12,0,0" Style="{StaticResource PhoneTextNormalStyle}"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="1" VerticalAlignment="Bottom"
                   Margin="12,0,12,24" TextWrapping="Wrap"
                   Foreground="{StaticResource PhoneAccentBrush}"
                   Style="{StaticResource PhoneTextSmallStyle}"/>
    </Grid>

</phone:PhoneApplicationPage>
