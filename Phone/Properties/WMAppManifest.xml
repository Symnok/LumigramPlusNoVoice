<?xml version="1.0" encoding="utf-8"?>
<Deployment xmlns="http://schemas.microsoft.com/windowsphone/2014/deployment" AppPlatformVersion="8.1">
  <DefaultLanguage xmlns="" code="en-US" />
  <App xmlns="" ProductID="{5E9A3C71-8D42-4B06-A1F7-3C08E2D95B64}" Title="Lumigram+" RuntimeType="Silverlight" Version="1.1.0.47" Genre="apps.normal" Author="Lumigram" Description="Telegram client for Windows Phone 8.1" Publisher="Lumigram" PublisherID="{B1D9E4F0-2C7A-4E58-9F31-6A8D0C5B2E14}">
    <IconPath IsRelative="true" IsResource="false">Assets\ApplicationIcon.png</IconPath>
    <!-- Networking only. The app talks to Telegram's datacenters and nothing else;
         contacts, media and sensors are not part of the text-only scope. -->
    <!-- Networking to reach Telegram; the media library to attach photos from the
         gallery. Without ID_CAP_MEDIALIB_PHOTO the picker fails at runtime rather
         than at build time. -->
    <Capabilities>
      <Capability Name="ID_CAP_NETWORKING"/>
      <Capability Name="ID_CAP_LOCATION"/>
      <Capability Name="ID_CAP_MEDIALIB_PHOTO"/>
      <Capability Name="ID_CAP_MEDIALIB_PLAYBACK"/>
      <Capability Name="ID_CAP_REMOVABLE_STORAGE"/>
      <Capability Name="ID_CAP_ISV_CAMERA"/>
      <!-- Recording voice messages. Without this the microphone simply is not
           there: Microphone.Default comes back null rather than failing. -->
      <Capability Name="ID_CAP_MICROPHONE"/>
    </Capabilities>
    <Tasks>
      <!--
        No ActivationPolicy="Resume". Fast app resume reactivates the existing
        instance when the tile is tapped, and the app has to re-navigate and
        restore itself; without that handling, activation never completes and the
        phone sits on "Resuming..." indefinitely. The default relaunch is correct
        here - MainPage routes to the right screen in a few milliseconds.
      -->
      <DefaultTask Name="_default" NavigationPage="MainPage.xaml">
        <!--
          Continuous background execution. The app does not use the position for
          anything; holding a Geolocator subscription is simply the mechanism by
          which Windows Phone lets an app keep running, which is what keeps the
          MTProto connection alive while Lumigram is not on screen.
        -->
        <BackgroundExecution>
          <ExecutionType Name="LocationTracking"/>
        </BackgroundExecution>
      </DefaultTask>
      <!--
        The periodic agent. Source is the assembly name and Type the class; both
        must match exactly or the OS refuses to schedule the task at runtime with
        no build-time complaint.
      -->
      <ExtendedTask Name="BackgroundTask">
        <BackgroundServiceAgent Specifier="ScheduledTaskAgent"
                                Name="LumigramAgent"
                                Source="Lumigram.Agent"
                                Type="Lumigram.Agent.ScheduledAgent" />
      </ExtendedTask>
    </Tasks>
    <Tokens>
      <PrimaryToken TokenID="LumigramToken" TaskName="_default">
        <TemplateFlip>
          <SmallImageURI IsRelative="true" IsResource="false">Assets\Tiles\FlipCycleTileSmall.png</SmallImageURI>
          <Count>0</Count>
          <BackgroundImageURI IsRelative="true" IsResource="false">Assets\Tiles\FlipCycleTileMedium.png</BackgroundImageURI>
          <Title>Lumigram+</Title>
          <BackContent></BackContent>
          <BackBackgroundImageURI></BackBackgroundImageURI>
          <BackTitle></BackTitle>
          <DeviceLockImageURI IsRelative="true" IsResource="false">Assets\Tiles\LockScreenIcon.png</DeviceLockImageURI>
          <HasLarge></HasLarge>
        </TemplateFlip>
      </PrimaryToken>
    </Tokens>
    <Extensions>
      <!--
        Lock screen. Without these two the app simply does not appear in
        Settings > lock screen, so there is nothing for the user to choose - the
        capability is declared, not requested at runtime.

        IconCount offers Lumigram as one of the small icons with a count beside
        it; TextField offers it as the single app allowed to show a line of
        text. Both are offers: the user still has to pick Lumigram in Settings,
        and neither slot is taken automatically.

        The count and the text are the tile's own - FlipTileData.Count and
        BackContent - so whatever LiveTile puts on the tile is what the lock
        screen shows, and nothing extra has to be maintained.

        The ConsumerID is the fixed identifier for the lock screen itself; it is
        the same GUID for every app.
      -->
      <Extension ExtensionName="LockScreen_Notification_IconCount"
                 ConsumerID="{111DFF24-AA15-4A96-8006-2BFF8122084F}"
                 TaskID="_default" />
      <Extension ExtensionName="LockScreen_Notification_TextField"
                 ConsumerID="{111DFF24-AA15-4A96-8006-2BFF8122084F}"
                 TaskID="_default" />

      <!--
        Registering file types is what makes the SD card visible to this app.
        On Windows Phone 8.1 an app enumerates removable storage only for the
        types it has associated itself with; with none registered,
        KnownFolders.RemovableDevices lists zero devices even when a card is
        physically present and working.
      -->
      <FileTypeAssociation Name="Lumigram video" TaskID="_default"
                           NavUriFragment="fileToken=%s">
        <Logos>
          <Logo Size="small" IsRelative="true">Assets/ApplicationIcon.png</Logo>
          <Logo Size="medium" IsRelative="true">Assets/ApplicationIcon.png</Logo>
          <Logo Size="large" IsRelative="true">Assets/ApplicationIcon.png</Logo>
        </Logos>
        <SupportedFileTypes>
          <FileType ContentType="video/mp4">.mp4</FileType>
          <FileType ContentType="video/quicktime">.mov</FileType>
          <FileType ContentType="video/3gpp">.3gp</FileType>
        </SupportedFileTypes>
      </FileTypeAssociation>
    </Extensions>
    <ScreenResolutions>
      <ScreenResolution Name="ID_RESOLUTION_WVGA" />
      <ScreenResolution Name="ID_RESOLUTION_WXGA" />
      <ScreenResolution Name="ID_RESOLUTION_HD720P" />
    </ScreenResolutions>
  </App>
</Deployment>
